{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AIDiag Console frontend deployment configuration",
  "type": "object",
  "required": [
    "schemaVersion",
    "project",
    "frontend",
    "backend",
    "platform",
    "checks",
    "rollback"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": "1.0.0"
    },
    "project": {
      "type": "object",
      "required": ["name", "displayName", "environment"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "displayName": { "type": "string", "minLength": 1 },
        "environment": { "const": "prod" }
      },
      "additionalProperties": false
    },
    "frontend": {
      "type": "object",
      "required": [
        "enabled",
        "deployType",
        "localPath",
        "installStrategy",
        "buildCommand",
        "buildOutputDir",
        "publicUrl",
        "apiBaseUrl",
        "healthCheckPaths",
        "acceptableStatusCodes"
      ],
      "properties": {
        "enabled": { "const": true },
        "deployType": { "const": "cloudflare-pages" },
        "localPath": { "type": "string", "minLength": 1 },
        "installStrategy": { "enum": ["npm-ci", "none"] },
        "buildCommand": { "const": "npm run build" },
        "buildOutputDir": { "type": "string", "minLength": 1 },
        "publicUrl": { "const": "https://ops.dduo.me" },
        "previewUrl": { "type": "string" },
        "apiBaseUrl": { "enum": ["/api/v1/console", "https://ops-api.dduo.me/api/v1/console"] },
        "healthCheckPaths": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" },
          "minItems": 1
        },
        "acceptableStatusCodes": {
          "type": "array",
          "items": { "type": "integer", "minimum": 100, "maximum": 599 },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "backend": {
      "type": "object",
      "required": ["enabled", "deployType"],
      "properties": {
        "enabled": { "const": false },
        "deployType": { "const": "springboot-jar-ssh" }
      },
      "additionalProperties": false
    },
    "platform": {
      "type": "object",
      "required": ["cloudflare"],
      "properties": {
        "cloudflare": {
          "type": "object",
          "required": ["pagesProjectName", "customDomain"],
          "properties": {
            "pagesProjectName": {
              "type": "string",
              "pattern": "^(?!REPLACE_WITH_)[A-Za-z0-9][A-Za-z0-9_-]{0,62}$"
            },
            "customDomain": { "const": "ops.dduo.me" },
            "previewUrl": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "checks": {
      "type": "object",
      "required": [
        "enableFrontendCheck",
        "enableBackendCheck",
        "enableCorsCheck",
        "enableSseCheck",
        "corsOrigin",
        "corsLoginUrl",
        "corsRequestMethod",
        "corsRequestHeaders",
        "sseUrl",
        "extraRouteChecks"
      ],
      "properties": {
        "enableFrontendCheck": { "const": true },
        "enableBackendCheck": { "const": false },
        "enableCorsCheck": { "type": "boolean" },
        "enableSseCheck": { "const": false },
        "corsOrigin": { "const": "https://ops.dduo.me" },
        "corsLoginUrl": { "const": "https://ops-api.dduo.me/api/v1/console/session" },
        "corsRequestMethod": { "const": "POST" },
        "corsRequestHeaders": { "type": "string" },
        "sseUrl": { "type": "string" },
        "extraRouteChecks": { "type": "array" }
      },
      "additionalProperties": false
    },
    "rollback": {
      "type": "object",
      "required": ["enabled", "keepReleases", "remoteBackupDir"],
      "properties": {
        "enabled": { "const": true },
        "keepReleases": { "type": "integer", "minimum": 1 },
        "remoteBackupDir": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
