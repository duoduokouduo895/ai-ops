# Copy this file to .env.cloud on the cloud server and set chmod 600.
# Never commit .env.cloud.
AIDIAG_DB_NAME=aidiag
AIDIAG_DB_USERNAME=aidiag
ALERTMANAGER_WEBHOOK_USERNAME=alertmanager
GRAFANA_ADMIN_USER=admin
DEPLOYMENT_ENVIRONMENT=cloud-demo
AIDIAG_PUBLIC_BIND=127.0.0.1
AIDIAG_PUBLIC_PORT=18080
GRAFANA_PUBLIC_BIND=127.0.0.1
GRAFANA_PUBLIC_PORT=13000
AIDIAG_SMOKE_ENABLED=false
AIDIAG_WORKER_ENABLED=true
AIDIAG_WORKER_POLL_DELAY_MS=1000
AIDIAG_WORKER_LEASE_SECONDS=30
AIDIAG_WORKER_HEARTBEAT_SECONDS=5
AIDIAG_WORKER_PROCESSING_DELAY_MS=0
AIDIAG_WORKER_MAX_ATTEMPTS=3
AIDIAG_WORKER_RETRY_BACKOFF_SECONDS=5
AIDIAG_STAGE3_ENABLED=false
AIDIAG_STAGE3_POLL_DELAY_MS=1000
AIDIAG_STAGE3_LEASE_SECONDS=30
AIDIAG_STAGE3_INITIAL_DELAY_SECONDS=30
AIDIAG_STAGE3_TOOL_TIMEOUT_SECONDS=8
# The reviewed target is official DeepSeek API / deepseek-v4-flash. Do not set this
# to true until the OpenAI-compatible Spring AI adapter, file-mounted API key and
# real-provider contract tests are complete. No model credential belongs in this file.
AIDIAG_STAGE4_ENABLED=false
AIDIAG_STAGE4_CHAT_MODEL=none
AIDIAG_STAGE4_PROMPT_VERSION=stage4-v1
AIDIAG_STAGE4_MAX_EVIDENCE=12
AIDIAG_STAGE4_TIMEOUT_SECONDS=12
AIDIAG_STAGE4_DAILY_REQUEST_LIMIT=20
AIDIAG_STAGE4_MAX_PROMPT_CHARS=16000
AIDIAG_STAGE4_MAX_OUTPUT_TOKENS=1200
AIDIAG_STAGE4_RETENTION_DAYS=30
AIDIAG_STAGE4_OPERATOR_USERNAME=aidiag-operator
FAULTLAB_DB_NAME=faultlab
FAULTLAB_DB_USERNAME=faultlab
FAULTLAB_HIKARI_MAX=4
FAULTLAB_HIKARI_CONNECTION_TIMEOUT_MS=500
FAULTLAB_ORDER_REQUEST_TIMEOUT_MS=1000
FAULTLAB_DOWNSTREAM_DELAY_MS=3000
FAULTLAB_ORDER_PUBLIC_BIND=127.0.0.1
FAULTLAB_ORDER_PUBLIC_PORT=18081
