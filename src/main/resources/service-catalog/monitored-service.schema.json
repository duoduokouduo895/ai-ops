{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidiag.dduo.me/schema/service-catalog-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "services"],
  "properties": {
    "version": { "const": 1 },
    "services": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "environment", "healthUrl", "metricsUrl", "otelServiceName", "diagnosisProfile", "dependencies"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
          "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
          "environment": { "type": "string", "enum": ["production", "staging", "local"] },
          "healthUrl": { "type": "string", "minLength": 10, "maxLength": 512 },
          "metricsUrl": { "type": "string", "minLength": 10, "maxLength": 512 },
          "otelServiceName": { "type": "string", "pattern": "^[a-zA-Z0-9._-]{1,128}$" },
          "diagnosisProfile": { "type": "string", "enum": ["ai-chat-v1", "aidiag-v1"] },
          "grafanaUrl": { "type": "string", "minLength": 10, "maxLength": 512 },
          "dependencies": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "kind", "target"],
              "properties": {
                "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$" },
                "kind": { "type": "string", "enum": ["http", "tcp"] },
                "target": { "type": "string", "minLength": 3, "maxLength": 512 },
                "signalComponent": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,62}$" }
              }
            }
          }
        }
      }
    }
  }
}
