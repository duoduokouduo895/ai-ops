# Install only after replacing certificate paths and validating with `nginx -t`.
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ops-api.dduo.me;

    ssl_certificate /etc/letsencrypt/live/ops-api.dduo.me/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/ops-api.dduo.me/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    location = /api/v1/console/session {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        client_max_body_size 4k;
        proxy_connect_timeout 2s;
        proxy_read_timeout 10s;
    }

    location ^~ /api/v1/console/ {
        proxy_pass http://127.0.0.1:18080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        client_max_body_size 4k;
        proxy_connect_timeout 2s;
        proxy_read_timeout 15s;
    }

    location / {
        return 404;
    }
}
